NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=noctua

# Opcional: conexão PostgreSQL hospedada; substitui DB_HOST/PORT/USER/PASSWORD/NAME.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# DB_SSL_CA_FILE=C:/caminho/para/certificado-do-provedor.crt
# Conexões hospedadas exigem TLS com validação de certificado.

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
# Configure apenas endereços ou redes dos proxies realmente confiáveis, separados por vírgula.
# TRUSTED_PROXY_CIDRS=127.0.0.1,10.0.0.0/8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_PAIR_LIMIT=5
AUTH_RESET_WINDOW_SECONDS=3600
AUTH_RESET_IP_LIMIT=30
AUTH_RESET_PAIR_LIMIT=3

MAIL_FROM=Noctua <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Ative o processador em pelo menos uma instância da API.
PUSH_WORKER_ENABLED=true
SCHOOL_TIMEZONE=America/Sao_Paulo
SCHOOL_NAME=Noctua
